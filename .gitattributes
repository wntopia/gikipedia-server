* text=auto eol=lf

# Scripts
mill text eol=lf
*.mill text eol=lf
*.sh text eol=lf
mill.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# GitHub Linguist language statistics
*.json linguist-language=JSON linguist-detectable=true
*.md linguist-language=Markdown linguist-detectable=true
