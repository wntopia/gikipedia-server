package build

import _root_.mill.*
import _root_.mill.api.BuildCtx
import _root_.mill.kotlinlib.*
import _root_.mill.javalib.spotless.*
import _root_.mill.javalib.spring.boot.*

val kotlinVer: String = "2.3.21"

object `package` extends KotlinMavenModule, SpringBootModule, SpotlessModule {
  def artifactName = "gikipedia-server"
  def springBootPlatformVersion = "4.1.1"
  def mainClass = Some("io.github.wntopia.gikipedia.server.GikipediaServerApplicationKt")
  def jvmVersion = "25"
  def kotlinVersion = kotlinVer
  def repositories: T[Seq[String]] = super.repositories() ++ Seq("https://jitpack.io")

  // kotlin-spring(all-open) + kotlin-jpa(no-arg) 컴파일러 플러그인.
  // Spring이 프록시·인스턴스화하는 클래스(@Configuration, @Service 등)를 open으로,
  // JPA 엔티티에 합성 무인자 생성자를 자동 생성한다.
  def kotlincPluginMvnDeps: T[Seq[Dep]] = Seq(
    mvn"org.jetbrains.kotlin:kotlin-allopen-compiler-plugin:$kotlinVer",
    mvn"org.jetbrains.kotlin:kotlin-noarg-compiler-plugin:$kotlinVer"
  )

  def kotlincOptions: T[Seq[String]] = super.kotlincOptions() ++ Seq(
    "-jvm-target",
    "25",
    "-Xjsr305=strict",
    // @JsonProperty/@BindParam 등을 파라미터뿐 아니라 프로퍼티/필드에도 적용 (Jackson 역직렬화 정합성)
    "-Xannotation-default-target=param-property",
    // Spring 스테레오타입 + JPA 엔티티를 모두 open으로 (지연 로딩 프록시 대응)
    "-P",
    "plugin:org.jetbrains.kotlin.allopen:preset=spring",
    "-P",
    "plugin:org.jetbrains.kotlin.allopen:annotation=jakarta.persistence.Entity",
    "-P",
    "plugin:org.jetbrains.kotlin.allopen:annotation=jakarta.persistence.MappedSuperclass",
    "-P",
    "plugin:org.jetbrains.kotlin.allopen:annotation=jakarta.persistence.Embeddable",
    // JPA 엔티티에 합성 무인자 생성자 생성
    "-P",
    "plugin:org.jetbrains.kotlin.noarg:preset=jpa"
  )

  def bomMvnDeps: T[Seq[Dep]] = Seq(
    mvn"org.springframework.boot:spring-boot-dependencies:4.1.1",
    mvn"org.springframework.modulith:spring-modulith-bom:2.1.0",
    mvn"software.amazon.awssdk:bom:2.54.2"
  )

  def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"org.jetbrains.kotlin:kotlin-reflect",
    mvn"tools.jackson.module:jackson-module-kotlin",
    mvn"org.springframework.boot:spring-boot-starter-cache",
    mvn"org.springframework.boot:spring-boot-starter-data-jpa",
    mvn"org.springframework.boot:spring-boot-starter-data-redis",
    mvn"org.springframework.boot:spring-boot-starter-data-mongodb",
    mvn"org.springframework.boot:spring-boot-starter-security",
    mvn"org.springframework.boot:spring-boot-starter-thymeleaf",
    mvn"org.springframework.boot:spring-boot-starter-validation",
    mvn"org.springframework.boot:spring-boot-starter-webmvc",
    mvn"org.springframework.boot:spring-boot-starter-websocket",
    mvn"org.springframework.session:spring-session-data-redis",
    mvn"org.springframework.modulith:spring-modulith-starter-core",
    mvn"org.springframework.modulith:spring-modulith-starter-jpa",
    mvn"org.thymeleaf.extras:thymeleaf-extras-springsecurity6",
    mvn"com.github.themoment-team:datagsm-oauth-sdk-java:1.6.0",
    mvn"com.github.themoment-team:the-sdk:1.5",
    mvn"io.github.openfeign.querydsl:querydsl-jpa:7.6",
    mvn"io.github.java-diff-utils:java-diff-utils:4.17",
    mvn"com.github.ben-manes.caffeine:caffeine",
    mvn"software.amazon.awssdk:s3",
    mvn"software.amazon.awssdk:url-connection-client"
  )

  def runMvnDeps: T[Seq[Dep]] = Seq(mvn"com.mysql:mysql-connector-j")

  def spotlessFormats: Task[Seq[Format]] = Task {
    // KtLint().configFile 기본값(.editorconfig)의 상대 경로 참조를 해석하기 위해
    // 기본 구현과 동일하게 파일시스템 체커를 끄고 동적 루트를 지정한다.
    BuildCtx.withFilesystemCheckerDisabled {
      Format.RelPathRef.withDynamicRoot(moduleDir) {
        Seq(
          Format(
            includes = Seq("glob:**.kt", "glob:**.kts"),
            steps = Seq(Format.KtLint())
          ),
          Format(
            includes = Seq(
              "glob:*.json",
              "glob:*.md",
              "glob:*.toml",
              "glob:*.yaml",
              "glob:*.yml",
              "glob:src/**/*.json",
              "glob:src/**/*.md",
              "glob:src/**/*.toml",
              "glob:src/**/*.yaml",
              "glob:src/**/*.yml"
            ),
            steps = Seq(Format.TrimTrailingWhitespace())
          )
        )
      }
    }
  }

  object test extends KotlinMavenTests, SpringBootTestsModule, TestModule.Junit5 {
    def bomMvnDeps: T[Seq[Dep]] = Seq(
      mvn"org.springframework.boot:spring-boot-dependencies:4.1.1",
      mvn"org.springframework.modulith:spring-modulith-bom:2.1.0"
    )

    def mvnDeps: T[Seq[Dep]] = Seq(
      mvn"org.springframework.boot:spring-boot-starter-data-jpa-test",
      mvn"org.springframework.boot:spring-boot-starter-data-redis-test",
      mvn"org.springframework.boot:spring-boot-starter-data-mongodb-test",
      mvn"org.springframework.boot:spring-boot-starter-security-test",
      mvn"org.springframework.boot:spring-boot-starter-thymeleaf-test",
      mvn"org.springframework.boot:spring-boot-starter-webmvc-test",
      mvn"org.springframework.modulith:spring-modulith-starter-test",
      mvn"org.mockito.kotlin:mockito-kotlin:6.3.0"
    )

    def runMvnDeps: T[Seq[Dep]] = Seq(
      mvn"org.junit.platform:junit-platform-launcher",
      // @DataJpaTest용 인메모리 DB. 운영은 MySQL을 쓰지만, 이 프로젝트엔 아직 통합 테스트용 DB가 없어서
      // Docker(Testcontainers) 없이 가볍게 돌아가는 H2를 골랐다 — MySQL과 락 세부 동작이 100% 같진 않지만
      // JPA/Hibernate 레벨의 행 잠금 직렬화 로직 자체는 검증할 수 있다.
      mvn"com.h2database:h2"
    )
  }
}
